  "flow": {
    "triggers": [
      {
        "id": "linak_bed_started_moving",
        "title": {
          "en": "The bed started moving",
          "no": "Sengen begynte å bevege seg"
        },
        "hint": {
          "en": "Fires when the bed actually starts moving, whether the command came from a button, a flow or the group device. Connecting to the bed can take a second or two, and this waits for the movement itself.",
          "no": "Utløses når sengen faktisk begynner å bevege seg, enten kommandoen kom fra en knapp, et flow eller gruppeenheten. Oppkoblingen kan ta et sekund eller to, og dette venter på selve bevegelsen."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ],
        "tokens": [
          {
            "name": "section",
            "type": "string",
            "title": {
              "en": "Section",
              "no": "Seksjon"
            },
            "example": {
              "en": "back up",
              "no": "back up"
            }
          }
        ]
      },
      {
        "id": "linak_bed_stopped_moving",
        "title": {
          "en": "The bed stopped moving",
          "no": "Sengen sluttet å bevege seg"
        },
        "hint": {
          "en": "Fires when the movement ends. A new press that takes over does not count as a stop, because the bed keeps moving.",
          "no": "Utløses når bevegelsen tar slutt. Et nytt trykk som overtar teller ikke som stopp, for da går sengen videre."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ],
        "tokens": [
          {
            "name": "section",
            "type": "string",
            "title": {
              "en": "Section",
              "no": "Seksjon"
            },
            "example": {
              "en": "back up",
              "no": "back up"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "no": "Årsak"
            },
            "example": {
              "en": "stop was pressed",
              "no": "stop was pressed"
            }
          }
        ]
      },
      {
        "id": "linak_bed_command_failed",
        "title": {
          "en": "A command to the bed failed",
          "no": "En kommando til sengen feilet"
        },
        "hint": {
          "en": "Fires when a command does not get through at all, which is not the same as a movement ending. A command that fails while connecting never moves the bed, so it never reports a stop either. This is the early warning that something is wrong with the link, rather than finding out at bedtime.",
          "no": "Utløses når en kommando ikke kommer fram, noe annet enn at en bevegelse tar slutt. En kommando som feiler under oppkoblingen beveger ingenting, og melder derfor heller ingen stopp. Dette er varselet om at noe er galt med forbindelsen, i stedet for å oppdage det ved sengetid."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ],
        "tokens": [
          {
            "name": "command",
            "type": "string",
            "title": {
              "en": "Command",
              "no": "Kommando"
            },
            "example": {
              "en": "back up",
              "no": "back up"
            }
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "no": "Årsak"
            },
            "example": {
              "en": "The bed did not accept the connection",
              "no": "The bed did not accept the connection"
            }
          }
        ]
      },
      {
        "id": "linak_bed_no_answer",
        "title": {
          "en": "The bed did not answer a measurement",
          "no": "Sengen svarte ikke på en måling"
        },
        "hint": {
          "en": "The app measures the signal by listening for the bed, which is a real test of whether it is there at all. This fires when that listening finds nothing, so you learn the bed is out of reach before you need it.",
          "no": "Appen måler signalet ved å lytte etter sengen, som er en ekte test på om den er der i det hele tatt. Dette utløses når lyttingen ikke finner noe, så du vet at sengen er utenfor rekkevidde før du trenger den."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ]
      },
      {
        "id": "linak_bed_signal_below",
        "title": {
          "en": "The Bluetooth signal fell below a level",
          "no": "Bluetooth-signalet falt under et nivå"
        },
        "titleFormatted": {
          "en": "The Bluetooth signal fell below [[level]] dBm",
          "no": "Bluetooth-signalet falt under [[level]] dBm"
        },
        "hint": {
          "en": "Fires on the measurement where the signal crosses your level going down, not on every measurement that is below it. Homey gives thresholds like this for the WiFi signal by itself, but the Bluetooth signal needed its own capability to get the right icon, and so it needs its own card too.",
          "no": "Utløses på målingen der signalet krysser nivået ditt på vei ned, ikke på hver eneste måling som ligger under. Homey gir slike terskler av seg selv for WiFi-signalet, men Bluetooth-signalet måtte bli en egen kapabilitet for å få riktig ikon, og da trenger det også sitt eget kort."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          },
          {
            "name": "level",
            "type": "number",
            "min": -110,
            "max": -30,
            "step": 1,
            "value": -85,
            "title": {
              "en": "Level, dBm",
              "no": "Nivå, dBm"
            }
          }
        ],
        "tokens": [
          {
            "name": "signal",
            "type": "number",
            "title": {
              "en": "Signal, dBm",
              "no": "Signal, dBm"
            },
            "example": -88
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "linak_bed_move",
        "title": {
          "en": "Move a section",
          "no": "Kjør en seksjon"
        },
        "titleFormatted": {
          "en": "Move [[section]] for [[duration]] seconds",
          "no": "Kjør [[section]] i [[duration]] sekunder"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          },
          {
            "name": "section",
            "type": "dropdown",
            "title": {
              "en": "Section",
              "no": "Seksjon"
            },
            "values": [
              {
                "id": "bothUp",
                "title": {
                  "en": "Both up",
                  "no": "Begge opp"
                }
              },
              {
                "id": "bothDown",
                "title": {
                  "en": "Both down",
                  "no": "Begge ned"
                }
              },
              {
                "id": "legUp",
                "title": {
                  "en": "Foot end up",
                  "no": "Beinende opp"
                }
              },
              {
                "id": "legDown",
                "title": {
                  "en": "Foot end down",
                  "no": "Beinende ned"
                }
              },
              {
                "id": "backUp",
                "title": {
                  "en": "Head end up",
                  "no": "Øvre del opp"
                }
              },
              {
                "id": "backDown",
                "title": {
                  "en": "Head end down",
                  "no": "Øvre del ned"
                }
              },
              {
                "id": "sitUp",
                "title": {
                  "en": "Sit up (feet down, head up)",
                  "no": "Sittestilling (bein ned, rygg opp)"
                }
              },
              {
                "id": "legRelief",
                "title": {
                  "en": "Leg relief (feet up, head down)",
                  "no": "Avlastning (bein opp, rygg ned)"
                }
              }
            ]
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Seconds",
              "no": "Sekunder"
            },
            "min": 1,
            "max": 120,
            "step": 1,
            "value": 4
          }
        ]
      },
      {
        "id": "linak_bed_stop_action",
        "title": {
          "en": "Stop all movement",
          "no": "Stopp all bevegelse"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          }
        ]
      },
      {
        "id": "linak_bed_light",
        "title": {
          "en": "Set the under-bed light",
          "no": "Sett lyset under sengen"
        },
        "titleFormatted": {
          "en": "Turn the under-bed light [[state]]",
          "no": "Slå lyset under sengen [[state]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          },
          {
            "name": "state",
            "type": "dropdown",
            "title": {
              "en": "State",
              "no": "Tilstand"
            },
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "linak_bed_flat",
        "title": {
          "en": "Set the bed flat",
          "no": "Legg sengen flat"
        },
        "hint": {
          "en": "Runs both sections down to their end stops, so the bed ends up in the same place every time regardless of where it started. This is the only position this bed can reach exactly, since it does not report where it is.",
          "no": "Kjører begge seksjonene ned til endestopp, så sengen ender likt hver gang uansett hvor den stod. Det er den eneste stillingen denne sengen kan treffe nøyaktig, siden den ikke rapporterer hvor den står."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          }
        ]
      },
      {
        "id": "linak_bed_preset",
        "title": {
          "en": "Go to a position",
          "no": "Kjør til en stilling"
        },
        "titleFormatted": {
          "en": "Go to a position: back [[back]] s, legs [[leg]] s",
          "no": "Kjør til en stilling: rygg [[back]] s, bein [[leg]] s"
        },
        "hint": {
          "en": "Goes flat first, then runs the back and the legs up for the times you give. Starting from the end stops is what makes it repeatable: the same numbers give the same position every time. Find your times once by moving the bed by hand and counting the seconds.",
          "no": "Går flat først, og kjører så rygg og bein opp så lenge du oppgir. At den starter fra endestopp er det som gjør den repeterbar: samme tall gir samme stilling hver gang. Finn tidene dine én gang ved å kjøre sengen for hånd og telle sekunder."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          },
          {
            "name": "back",
            "type": "number",
            "min": 0,
            "max": 60,
            "step": 1,
            "value": 8,
            "title": {
              "en": "Back, seconds",
              "no": "Rygg, sekunder"
            }
          },
          {
            "name": "leg",
            "type": "number",
            "min": 0,
            "max": 60,
            "step": 1,
            "value": 0,
            "title": {
              "en": "Legs, seconds",
              "no": "Bein, sekunder"
            }
          }
        ]
      },
      {
        "id": "linak_bed_measure",
        "title": {
          "en": "Measure the status now",
          "no": "Mål statusen nå"
        },
        "hint": {
          "en": "Listens for the bed and reads the proxy, which updates the Bluetooth signal, the WiFi signal and whether the bed answers at all. The card returns at once and the measurement finishes in the background, because it takes twelve seconds. Use it to choose when measuring happens instead of leaving it to the interval in the device settings.",
          "no": "Lytter etter sengen og leser av proxyen, som oppdaterer Bluetooth-signalet, WiFi-signalet og om sengen svarer i det hele tatt. Kortet svarer med én gang og målingen fullføres i bakgrunnen, siden den tar tolv sekunder. Bruk den til å bestemme selv når det måles, i stedet for å overlate det til intervallet i enhetsinnstillingene."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ]
      },
      {
        "id": "linak_bed_reset_connection",
        "title": {
          "en": "Reset the connection",
          "no": "Nullstill tilkoblingen"
        },
        "hint": {
          "en": "Drops the Bluetooth session and the connection to the proxy, so the next command builds both again. This is what the Repair screen does, and what restarting the app does, available to a flow so the app can recover without you opening anything.",
          "no": "Slipper Bluetooth-økten og forbindelsen til proxyen, så neste kommando bygger begge på nytt. Det er det Reparer-skjermen gjør, og det en appomstart gjør, tilgjengelig for en flow slik at appen kan hente seg inn uten at du åpner noe."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "linak_bed_condition_light",
        "title": {
          "en": "The under-bed light !{{is|is not}} on",
          "no": "Lyset under sengen !{{er|er ikke}} på"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed|all_beds"
          }
        ]
      },
      {
        "id": "linak_bed_condition_moving",
        "title": {
          "en": "The bed !{{is|is not}} moving",
          "no": "Sengen !{{beveger|beveger ikke}} seg"
        },
        "hint": {
          "en": "True while a movement this app started is still running. Use it to keep two flows from fighting over the same motor.",
          "no": "Sann mens en bevegelse appen startet fortsatt går. Bruk den til å hindre at to flows krangler om samme motor."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ]
      },
      {
        "id": "linak_bed_condition_error",
        "title": {
          "en": "The bed !{{is|is not}} in an error state",
          "no": "Sengen !{{er|er ikke}} i feiltilstand"
        },
        "hint": {
          "en": "True when the last command or measurement failed. Pair it with the reset action to let a flow repair the connection by itself.",
          "no": "Sann når siste kommando eller måling feilet. Sett den sammen med nullstillingshandlingen, så kan en flow reparere forbindelsen selv."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          }
        ]
      },
      {
        "id": "linak_bed_condition_signal_below",
        "title": {
          "en": "The Bluetooth signal !{{is|is not}} below a level",
          "no": "Bluetooth-signalet !{{er|er ikke}} under et nivå"
        },
        "titleFormatted": {
          "en": "The Bluetooth signal !{{is|is not}} below [[level]] dBm",
          "no": "Bluetooth-signalet !{{er|er ikke}} under [[level]] dBm"
        },
        "hint": {
          "en": "Uses the last measurement, not a fresh one, since measuring takes twelve seconds. Put the measure action before it if you need the number to be current.",
          "no": "Bruker siste måling, ikke en fersk, siden en måling tar tolv sekunder. Sett målekortet foran hvis tallet må være ferskt."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=bed"
          },
          {
