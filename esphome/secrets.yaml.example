# Copy to secrets.yaml next to linak-bed-proxy.yaml and fill in your own values.
# secrets.yaml itself is gitignored — never commit the real one.

wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Password for the setup hotspot the board opens if it cannot reach your WiFi.
# Any password you choose; you only need it if the board fails to connect.
fallback_password: "any-password-you-choose"
